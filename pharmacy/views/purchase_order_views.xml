<odoo>
    <data>
        <record id='purchase_order_tree_view' model='ir.ui.view'>
            <field name="name">purchase order</field>
            <field name="model">purchase.order</field>
            <field name="arch" type='xml'>
                <tree>
                    <field name="purchase_number" />
                    <field name="vendor_id" />
                    <field name="create_date" />
                    <field name="create_uid" />
                </tree>
            </field>
        </record>

        <record id='purchase_order_form_view' model='ir.ui.view'>
            <field name="name">purchase order</field>
            <field name="model">purchase.order</field>
            <field name="arch" type='xml'>
                <form>
                    <sheet>
                        <div>
                            <label for='purchase_number' />
                            <h1>
                                <field name="purchase_number" />
                            </h1>
                        </div>
                        <group>
                            <field name="vendor_id" />
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="lines_ids"
                                    context="{'tree_view_ref':'pharmacy.items_lines_tree_view'}" />
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id='purchase_order_menu_action' model='ir.actions.act_window'>
            <field name="name">Purchase Order Menu</field>
            <field name="res_model">purchase.order</field>
        </record>
        <menuitem id='purchase_order_menu'
            name='Purchase Order'
            parent='main_pharmacy_menu'
            action='purchase_order_menu_action' />
    </data>
</odoo>