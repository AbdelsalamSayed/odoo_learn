<odoo>
    <data>
        <record id='purchase_order_lines_tree_view' model='ir.ui.view'>
            <field name="name">purchase order lines</field>
            <field name="model">purchase.order.lines</field>
            <field name="arch" type='xml'>
                <tree editable='bottom'>
                    <field name="barcode" />
                    <field name="items_id" />
                    <field name="price" />
                    <field name="cost" />
                    <field name="exp_date" />
                    <field name="quantity" />
                </tree>
            </field>
        </record>

    </data>
</odoo>