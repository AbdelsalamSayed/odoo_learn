<odoo>
    <data>
        <record id='payroll_tree_view' model='ir.ui.view'>
            <field name="name">payroll tree view</field>
            <field name="model">employee.payroll</field>
            <field name="arch" type='xml'>
                <tree create='0' delete='0'>
                    <header>
                        <button type='object' name='generate_all_payrolls'
                            string='Generate This Month'
                            class='btn-success' icon='fa-cogs' display='always'
                            groups='hr_system.ceo_groups_record,hr_system.hr_perm_group' />
                        <button type='object' name='unlink_all_payrolls'
                            string='Delete This Month'
                            class='btn-danger' icon='fa-cogs' display='always'
                            groups='hr_system.ceo_groups_record,hr_system.hr_perm_group' />
                    </header>
                    <field name="employee_id" />
                    <field name="month" />
                    <field name="year" />
                    <field name="net_salary" />
                </tree>
            </field>
        </record>
        <record id='payroll_form_view' model='ir.ui.view'>
            <field name="name">payroll form view</field>
            <field name="model">employee.payroll</field>
            <field name="arch" type='xml'>
                <form create='0' delete='0'>
                    <sheet>
                        <group>
                            <label for='employee_id' string='Employee' />
                            <div class='o_row'>
                                <label for='employee_id' string='' />
                                <h3>
                                    <field name="employee_id" readonly='True' />
                                </h3>
                                <label for='month' string='Payroll Month' />
                                <h3>
                                    <field name="month" readonly='True' />
                                </h3>
                                <label for='year' string='Payroll Year' />
                                <h3>
                                    <field name="year" readonly='True' />
                                </h3>
                            </div>
                        </group>
                        <group>
                            <group>
                                <field name="employee_shift_hours" />
                                <field name="basic_salary" />
                                <field name="total_worked_hours" />
                            </group>
                            <group>
                                <field name="bonus_min" />
                                <field name="overtime_min" />
                                <field name="employee_deduction" />
                                <field name="present_vacation_days" />
                                <field name="loan" readonly='True' />
                            </group>
                            <group>
                                <field name="net_salary" />
                            </group>
                            <notebook>
                                <page string='Loans'>
                                    <field name="loan_id" readonly='True' />
                                </page>
                            </notebook>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="employee_payroll_view_search" model="ir.ui.view">
            <field name="name">employee payroll view search</field>
            <field name="model">employee.payroll</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"
                        groups='hr_system.ceo_groups_record,hr_system.hr_perm_group' />
                    <field name="month" />
                    <field name="year" />
                    <filter name="month" string="Group by month" context="{'group_by': 'month'}" />
                    <filter name="year" string="Group by year" context="{'group_by': 'year'}" />
                    <filter name="employee_id" string="Group by employee"
                        context="{'group_by': 'employee_id'}"
                        groups='hr_system.ceo_groups_record,hr_system.hr_perm_group' />
                </search>
            </field>
        </record>
        <record id='payroll_menu_action' model='ir.actions.act_window'>
            <field name="name">Payroll</field>
            <field name="res_model">employee.payroll</field>
            <field name="domain">[('employee_id.related_user','=',uid)]</field>
        </record>
        <record id='all_payroll_menu_action' model='ir.actions.act_window'>
            <field name="name">Payroll</field>
            <field name="res_model">employee.payroll</field>
        </record>
        <menuitem id='payroll_menu'
            name='Employees payrolls'
            parent='employees_main_menu_item'
            action='all_payroll_menu_action'
            groups='hr_system.ceo_groups_record,hr_system.hr_perm_group'
            sequence='4'
        />
        <record id='my_payroll_rule' model='ir.rule'>
            <field name="name">My Payroll Rule</field>
            <field name="model_id" ref='model_employee_payroll' />
            <field name="groups"
                eval="[(4,ref('hr_system.employee_perm_group')),(4,ref('hr_system.manager_perm_group'))]" />
            <field name="domain_force">[('employee_id.related_user','=',user.id)]</field>
        </record>
    </data>
</odoo>