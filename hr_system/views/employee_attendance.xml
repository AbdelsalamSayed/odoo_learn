<odoo>
    <data>
        <record id="employee_attendance_view_form" model="ir.ui.view">
            <field name="name">employee.attendance.view.form</field>
            <field name="model">employee.attendance</field>
            <field name="arch" type="xml">
                <form create='0' edit='0' delete='0'>
                    <sheet>
                        <header>
                            <button type='object' name='open_my_profile' string='My Profile'
                                display='always' icon='fa-id-badge' class='btn-primary' />
                        </header>
                        <div name='button_box' class='oe_button_box'>
                            <button type='object' name='open_attendance_logs' string='attendance'
                                icon='fa-solid fa-calendar'
                                invisible='related_user != uid ' />
                            <button type='object' name='open_bonus_logs' string='Bonus'
                                icon='fa-star' invisible='related_user != uid' />
                            <button type='object' name='open_overtime_logs' string='Overtime'
                                icon='fa-hourglass-half' invisible='related_user != uid' />
                            <button type='object' name='open_loan_logs' string='Loan'
                                icon='fa-university' invisible='related_user != uid' />
                            <button type='object' name='open_payroll_logs' string='Payroll'
                                icon='fa-money'
                                invisible='related_user != uid' />
                        </div>
                        <group>
                            <field name="related_user" invisible='1' />
                            <field name="in_time" string='IN Time' />
                            <div colspan="2"
                                style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 15px; margin: 10px 0;">
                                <div
                                    class='o_row'
                                    style="background-color: #121212; color: #ffffff; padding: 15px 20px; border-radius: 25px;">
                                    <div class='d-flex flex-column align-items-center'>
                                        <div
                                            style="width: 100%; display: flex; justify-content: center; margin: 10px 0; background-color: #ffffff; border-radius: 15px;">
                                            <h1>
                                                <field name="employee_id" />
                                            </h1>
                                        </div>
                                        <div class='o_row' style='margin: 10px 0;'>
                                            <div
                                                style="background-color: #333333; color: #ffffff; padding: 6px 12px; border-radius: 13px;">
                                                <field name="hours" />
                                            </div>
                                            : <div
                                                style="background-color: #333333; color: #ffffff; padding: 6px 12px; border-radius: 13px;">
                                                <field name="minutes" />
                                            </div>
                                            : <div
                                                style="background-color: #333333; color: #ffffff; padding: 6px 12px; border-radius: 13px;">
                                                <field name="seconds" />
                                            </div>
                                            <div
                                                style='margin: 0 10px;'>
                                                <button type='object' name='check_out_to_employee'
                                                    string='Check-out'
                                                    class="btn btn-danger"
                                                    style="border-radius: 8px; padding: 10px 20px;"
                                                    invisible='employee_state in ["out","yet_to_check_in","weekend"]' />
                                                <button type='object' name='check_in_to_employee'
                                                    string='Check-In'
                                                    class="btn btn-success"
                                                    style="border-radius: 8px; padding: 10px 20px;"
                                                    invisible='employee_state in ["in","present"]' />
                                            </div>
                                        </div>
                                        <field
                                            name="employee_state"
                                            decoration-success='employee_state in ["in","present"]'
                                            decoration-danger='employee_state in ["out","yet_to_check_in"]'
                                            decoration-warning='employee_state == "weekend"' />
                                    </div>
                                </div>
                            </div>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="attendance_action_server" model="ir.actions.server">
            <field name="name">attendance server action</field>
            <field name="model_id" ref="model_employee_attendance" />
            <field name="binding_model_id" ref="model_employee_attendance" />
            <field name="state">code</field>
            <field name="code">
                action=model.open_my_attendance()
            </field>
        </record>
        <record id='attendance_action' model='ir.actions.act_window'>
            <field name="name">Attendance1</field>
            <field name="res_model">employee.attendance</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref='hr_system.employee_attendance_view_form' />
        </record>
        <menuitem
            id="home_main_menu"
            name="Home"
            action="attendance_action_server"
            parent="hr_system_main_menu"
            sequence="1" />
    </data>

</odoo>