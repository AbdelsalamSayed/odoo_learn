<odoo>
    <data>
        <record id="employee_attendance_view_form" model="ir.ui.view">
            <field name="name">employee.attendance.view.form</field>
            <field name="model">employee.attendance</field>
            <field name="arch" type="xml">
                <form create='0' edit='0' delete='0'>
                    <sheet>
                        <group>
                            <div colspan="2"
                                style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 15px; margin: 10px 0;">
                                <div
                                    style="background-color: #333333; color: #ffffff; padding: 8px 12px; border-radius: 8px;">
                                    <field name="hours" />
                                </div> : <div
                                    style="background-color: #333333; color: #ffffff; padding: 8px 12px; border-radius: 8px;">
                                    <field name="minutes" />
                                </div> : <div
                                    style="background-color: #333333; color: #ffffff; padding: 8px 12px; border-radius: 8px;">
                                    <field name="seconds" />
                                </div>
                                <div>
                                    <button type='object' name='check_out_to_employee'
                                        string='Check-out'
                                        class="btn btn-danger"
                                        style="border-radius: 8px; padding: 10px 20px;"
                                        invisible='employee_state in ["out","yet_to_check_in"]' />
                                    <button type='object' name='check_in_to_employee'
                                        string='Check-In'
                                        class="btn btn-success"
                                        style="border-radius: 8px; padding: 10px 20px;"
                                        invisible='employee_state in ["in","present"]' />
                                </div>
                            </div>
                            <div>
                                <h1>
                                    <field name="employee_id" />
                                </h1>
                                <h3>
                                    <field name="employee_state"
                                        decoration-success='employee_state in ["in","present"]'
                                        decoration-danger='employee_state in ["out","yet_to_check_in"]'
                                        decoration-info='employee_state == "weekend" ' />
                                </h3>
                            </div>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id='attendance_action' model='ir.actions.act_window'>
            <field name="name">Attendance1</field>
            <field name="res_model">employee.attendance</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref='hr_system.employee_attendance_view_form' />
        </record>
        <menuitem id='attendance_in_out'
            name='Attendance'
            parent='hr_system_main_menu'
            action='attendance_action'
            sequence='20' />
    </data>

</odoo>