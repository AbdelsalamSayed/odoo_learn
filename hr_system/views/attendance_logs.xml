<odoo>
    <data>
        <record id="attendance_view_tree" model="ir.ui.view">
            <field name="name">attendance_view_tree</field>
            <field name="model">employee.attendance.logs</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="employee_id" />
                    <field name="log_time" />
                    <field name='log_type' />
                    <field name="is_weekend" />
                </tree>
            </field>
        </record>
        <record id='attendance_logs_action' model='ir.actions.act_window'>
            <field name="name">Attendance</field>
            <field name="res_model">employee.attendance.logs</field>
        </record>
        <menuitem id='attendance_logs'
            name='Employees Attendance'
            parent='hr_system_main_menu'
            action='attendance_logs_action'
            groups='hr_system.ceo_groups_record,hr_system.hr_perm_group,hr_system.manager_perm_group'
            sequence='11' />

        <record id='my_attendance_rule' model='ir.rule'>
            <field name="name">My Attendance Rule</field>
            <field name="model_id" ref='model_employee_attendance' />
            <field name="groups" eval="[(4,ref('hr_system.employee_perm_group'))]" />
            <field name="domain_force">[('employee_id.related_user','=',user.id)]</field>
        </record>
        <record id='my_manager_attendance_rule' model='ir.rule'>
            <field name="name">My Attendance Rule</field>
            <field name="model_id" ref='model_employee_attendance' />
            <field name="groups" eval="[(4,ref('hr_system.manager_perm_group'))]" />
            <field name="domain_force">
                ['|',('employee_id.related_user','=',user.id),('employee_id.employee_manager.related_user','=',user.id)]</field>
        </record>
    </data>

</odoo>