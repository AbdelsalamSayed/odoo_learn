<odoo>
    <data>
        <record
            id='employee_tree_view' model='ir.ui.view'>
            <field name="name">Employees</field>
            <field name="model">employee</field>
            <field name="arch" type='xml'>
                <tree create='0'>
                    <field name="employee_image" options='{"size":[60,60]}'
                        widget='image' />
                    <field name="id" string='Employee ID' />
                    <field name="employee_name" />
                    <field name="department_id" />
                    <field name="employee_number" />
                    <field name="employee_birth_date" />
                </tree>
            </field>
        </record>
        <record
            id="employee_view_search" model="ir.ui.view">
            <field name="name">employee view search</field>
            <field name="model">employee</field>
            <field name="arch" type="xml">
                <search>
                    <field name="id" />
                    <field name="employee_name" />
                    <field name="department_id" />
                    <filter name='archived' string='Archived' domain='[("active","=",False)]'
                        groups='hr_system.ceo_groups_record,hr_system.hr_perm_group' />
                </search>
            </field>
        </record>
        <record
            id='employee_form_view' model='ir.ui.view'>
            <field name="name">Employees</field>
            <field name="model">employee</field>
            <field name="arch" type='xml'>
                <form create='0'>
                    <sheet readonly='related_user == uid '>
                        <header>
                            <field name="employee_image" options='{"size":[60,60]}' widget='image' />
                            <div>
                                <label for='id' string='Employee ID' />
                                <h1>
                                    <field name="id" invisible='id==0' />
                                </h1>
                                <label for='state_in' string='' />
                                <h3>
                                    <field name="state_in"
                                        decoration-success='state_in in ["in","present"]'
                                        decoration-danger='state_in in ["out","yet_to_check_in"]'
                                        decoration-warning='state_in == "weekend"' />
                                </h3>
                            </div>
                        </header>
                        <group>
                            <group string="Basic information">
                                <field name="employee_name" />
                                <field name="related_user" />
                                <field name="employee_number" />
                                <field name="employee_birth_date" />
                                <field name="employee_basic_salary" invisible='related_user != uid' />
                                <field name="employee_basic_salary" invisible='related_user == uid'
                                    groups='hr_system.ceo_groups_record,hr_system.hr_perm_group' />
                                <label for='employee_shift_from' string='Shift' />
                                <div class='o_row'>
                                    <label for='employee_shift_from' string='From' />
                                    <field name="employee_shift_from" widget='float_time' />
                                    <field name="employee_shift_from_period" />
                                    <label for='employee_shift_to' string='To' />
                                    <field name="employee_shift_to" widget='float_time' />
                                    <field name="employee_shift_to_period" />
                                </div>
                                <field name="employee_shift_hours" />
                                <field name="active" invisible='True' />
                            </group>
                            <group string="Work information">
                                <field name="department_id" />
                                <field name="employee_role" readonly='not department_id' />
                                <field name="employee_manager"
                                    domain="[('employee_role','in',['owner', 'manager'])]" />
                                <label for='end_sat' string='Weekend' />
                                <div class='d-flex flex-row gap-4 align-items-start'>
                                    <div class='d-flex flex-column align-items-center'>
                                        <label for='end_sat' string='Sat' />
                                        <field name="end_sat" />
                                    </div>
                                    <div class='d-flex flex-column align-items-center'>
                                        <label for='end_sun' string='Sun' />
                                        <field name="end_sun" />
                                    </div>
                                    <div class='d-flex flex-column align-items-center'>
                                        <label for='end_mon' string='Mon' />
                                        <field name="end_mon" />
                                    </div>
                                    <div class='d-flex flex-column align-items-center'>
                                        <label for='end_tus' string='Tus' />
                                        <field name="end_tus" />
                                    </div>
                                    <div class='d-flex flex-column align-items-center'>
                                        <label for='end_wed' string='Wed' />
                                        <field name="end_wed" />
                                    </div>
                                    <div class='d-flex flex-column align-items-center'>
                                        <label for='end_thu' string='Thu' />
                                        <field name="end_thu" />
                                    </div>
                                    <div class='d-flex flex-column align-items-center'>
                                        <label for='end_fri' string='Fri' />
                                        <field name="end_fri" />
                                    </div>
                                </div>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record
            id='employee_model_view_action' model='ir.actions.act_window'>
            <field name="name">Employees</field>
            <field name='res_model'>employee</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record
            id='employee_department_model_view_action' model='ir.actions.act_window'>
            <field name="name">Departments</field>
            <field name='res_model'>employee</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'group_by': 'department_id'}</field>
        </record>
        <menuitem
            id="employee_menu"
            name="Employees"
            parent="employees_main_menu_item"
            action="employee_model_view_action"
            groups='hr_system.employee_perm_group,hr_system.hr_perm_group,hr_system.manager_perm_group'
            sequence="1" />
        <menuitem
            id="employee_department_menu"
            name="Employees department"
            parent="company_menu_item"
            action="employee_department_model_view_action"
            sequence="1" />

    </data>
</odoo>