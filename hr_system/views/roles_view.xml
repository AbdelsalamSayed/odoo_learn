<odoo>
    <data>
        <record id='roles_tree_view' model='ir.ui.view'>
            <field name="name">Roles</field>
            <field name="model">roles</field>
            <field name="arch" type='xml'>
                <tree editable='bottom'>
                    <field name="role_name" />
                    <field name="perm" />
                </tree>
            </field>
        </record>
        <record id='roles_model_view_action' model='ir.actions.act_window'>
            <field name="name">Roles</field>
            <field name='res_model'>roles</field>
            <field name="view_mode">tree</field>
        </record>
        <menuitem id='hr_roles_menu'
            name='roles'
            parent='hr_system_main_menu'
            action='roles_model_view_action'
            groups='hr_system.ceo_groups_record' />
    </data>
</odoo>