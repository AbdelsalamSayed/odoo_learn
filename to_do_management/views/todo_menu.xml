<odoo>

    <record id="server_close_action" model="ir.actions.server">
        <field name="name">Close</field>
        <field name="model_id" ref='model_todo_task' />
        <field name="binding_model_id" ref='model_todo_task' />
        <field name="state">code</field>
        <field name='code'>action = records.state_closed()</field>
    </record>

    <record id="due_date_check_cr" model="ir.cron">
        <field name="name">due date</field>
        <field name="model_id" ref='model_todo_task' />
        <field name="state">code</field>
        <field name='code'>model.check_due_date()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>


    <record id='todo_tree_view' model='ir.ui.view'>
        <field name="name">ToDo Tree</field>
        <field name="model">todo.task</field>
        <field name="arch" type='xml'>
            <tree class='test' decoration-danger="(is_late)"
                decoration-success="status=='completed'">
                <button name='state_in_progress' string='In Progress' type='object'
                    class='btn-primary'
                    invisible='status=="in_progress" or status=="completed" or status=="closed"' />
                <button name='state_completed' string='Completed' type='object'
                    class='btn-primary'
                    invisible='status in ("completed","new","closed")' />
                <field name='task_name' />
                <field name='assign_to' />
                <field name='description' />
                <field name='due_date' />
                <field name='is_late' invisible='True' />
                <field name='estimated_time' />
                <field name='active' invisible='1' />
                <field name='status' widget='statusbar' />
            </tree>
        </field>
    </record>

    <record id='todo_form_view' model='ir.ui.view'>
        <field name="name">ToDo Form</field>
        <field name="model">todo.task</field>
        <field name='arch' type='xml'>
            <form>
                <sheet>
                    <header>
                        <button name='state_new' string='New' type='object'
                            class='btn-primary' invisible='status=="new"' />
                        <button name='state_in_progress' string='In Progress' type='object'
                            class='btn-primary' invisible='status=="in_progress"' />
                        <button name='state_completed' string='Completed' type='object'
                            class='btn-primary' invisible='status=="completed"' />
                        <field name='status' widget='statusbar' />
                    </header>
                    <div class='oe_title'>
                        <label for="task_name" />
                        <h1>
                            <field name='task_name' readonly='status == "closed"' />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name='assign_to' readonly='status == "closed"' />
                            <field name='due_date' readonly='status == "closed"' />
                        </group>
                        <group>
                            <field name='description' readonly='status == "closed"' />
                            <field name='estimated_time' readonly='status == "closed"' />
                            <field name='active' invisible='1' />
                            <field name='is_late' invisible='True' />
                        </group>

                    </group>
                    <notebook>
                        <page string='Details'>
                            <field name="details_ids" readonly='status == "closed"' />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id='todo_search_view' model='ir.ui.view'>
        <field name="name">ToDo Search</field>
        <field name="model">todo.task</field>
        <field name="arch" type='xml'>
            <search>
                <field name="task_name" />
                <field name="assign_to" />
                <filter name='search' string='New' domain='[("status","=","new")]' />
                <filter name='Archived' string='Archived' domain='[("active","=",False)]' />
                <filter name='search' string='In Progress' domain='[("status","=","in_progress")]' />
                <filter name='search' string='Completed' domain='[("status","=","completed")]' />
                <filter name='search' string='Assign To' context='{"group_by":"assign_to"}' />
                <filter name='search' string='Status' context='{"group_by":"status"}' />
                <filter name='search' string='Due Date' context='{"group_by":"due_date"}' />


            </search>
        </field>
    </record>

    <record id='todo_action' model='ir.actions.act_window'>
        <field name="name">ToDo action</field>
        <field name="res_model">todo.task</field>
    </record>
    <menuitem id='all_tasks_menu'
        name='All Tasks'
        parent='todo_menu'
        action='todo_action' />
</odoo>