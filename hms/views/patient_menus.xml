<odoo>
    <record id='view_log' model='ir.actions.act_window'>
        <field name="name">log Action</field>
        <field name="res_model">hms.patient.log</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('patient_id','=',active_id)]</field>
    </record>


    <record id='search_view' model='ir.ui.view'>
        <field name="name">search view</field>
        <field name="model">hms.patient</field>
        <field name="arch" type='xml'>
            <search>
                <filter name="search" string='Archived' domain='[("active","=",False)]' />
            </search>
        </field>
    </record>

    <record id='patient_tree' model='ir.ui.view'>
        <field name="name">Patient Tree</field>
        <field name="model">hms.patient</field>
        <field name='arch' type='xml'>
            <tree>
                <field name="image" widget='image' options='{"size":[50,50]}'
                    optional='1' />
                <field name="full_name" />
                <field name="phone_number" />
                <field name="age" />
                <field name="blood_type" />
                <field name="cr_ratio" />
                <field name="pcr" />
                <field name='states' />
                <field name='department_id' />
                <field name='active' />
                <field name='doctors_ids' widget='many2many_tags' optional='1' />
                <field name="address" optional='1' />
                <field name="history" optional='1' />

            </tree>
        </field>
    </record>
    <record id='logs_tree' model='ir.ui.view'>
        <field name="name">logs Tree</field>
        <field name="model">hms.patient.log</field>
        <field name='arch' type='xml'>
            <tree edit='0' create='0' delete='0'>
                <field name="create_uid" />
                <field name="create_date" />
                <field name="description" />
            </tree>
        </field>
    </record>
    <record id='patient_form' model='ir.ui.view'>
        <field name="name">Patient Form</field>
        <field name="model">hms.patient</field>
        <field name='arch' type='xml'>
            <form>
                <header>
                    <button name="state_good" type="object" class="btn-primary" string='Good'
                        invisible='states == "good"' />
                    <button name="state_undetermined" type="object" class="btn-primary"
                        string='Undetermined'
                        invisible='states == "undetermined"' />
                    <button name="state_fair" type="object" class="btn-primary" string='Fair'
                        invisible='states == "fair"' />
                    <button name="state_serious" type="object" class="btn-primary" string='serious'
                        invisible='states == "serious"' />
                    <button name="%(view_log)d" type="action" class="oe_stat_button"
                        icon="fa-list" string='Logs' />
                    <field name="states" widget='statusbar' />
                </header>
                <sheet>
                    <field name="image" widget='image' class='oe_avatar' />
                    <group string='Patient Information'>
                        <group>
                            <field name="first_name" />
                            <field name="phone_number" />
                            <field name="birth_date" />
                            <field name="active" />
                            <field name="department_id"
                                domain='[("is_opened","=",True)]' />
                            <field name="doctors_ids"
                                domain='[("department_id","=",department_id)]'
                                widget='many2many_tags'
                                readonly='not department_id' />
                            <field name="pcr" />
                        </group>
                        <group>
                            <field name="last_name" />
                            <field name="age" />
                            <field name="capacity" />
                            <field name="blood_type" />
                            <field name="cr_ratio" />


                        </group>

                    </group>
                    <group string='Patient History' invisible="age &lt; 50">
                        <field name="history" />

                    </group>

                </sheet>
            </form>
        </field>
    </record>
    <record id='patient_active' model='ir.actions.act_window'>
        <field name="name">Patient active</field>
        <field name="res_model">hms.patient</field>
    </record>
    <menuitem id='patient_tree_menu_active'
        name='Activated'
        parent='patient_menu'
        action='patient_active' />

</odoo>