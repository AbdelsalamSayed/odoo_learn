<odoo>
    <record id='patient_tree' model='ir.ui.view'>
        <field name="name">Patient Tree</field>
        <field name="model">hms.patient</field>
        <field name='arch' type='xml'>
            <tree>
                <field name="image" widget='image' options='{"size":[50,50]}'
                    optional='1' />
                <field name="full_name" />
                <field name="age" />
                <field name="blood_type" />
                <field name="cr_ratio" />
                <field name="pcr" />
                <field name='states' />
                <field name='department_id' />
                <field name='doctors_ids' widget='many2many_tags' optional='1' />
                <field name="address" optional='1' />
                <field name="history" optional='1' />
            </tree>
        </field>
    </record>
    <record id='patient_form' model='ir.ui.view'>
        <field name="name">Patient Form</field>
        <field name="model">hms.patient</field>
        <field name='arch' type='xml'>
            <form>
                <header>
                    <field name="states" widget='statusbar' />
                </header>
                <sheet>
                    <field name="image" widget='image' class='oe_avatar' />
                    <group string='Patient Information'>
                        <group>
                            <field name="first_name" />
                            <field name="birth_date" />
                            <field name="department_id"
                                domain='[("is_opened","=",True)]' />
                            <field name="doctors_ids" readonly='not department_id'
                                domain='[("department_id","=",department_id)]'
                                widget='many2many_tags' />
                            <field name="pcr" />
                        </group>

                        <group>
                            <field name="last_name" />
                            <field name="age" />
                            <field name="capacity" />
                            <field name="blood_type" />
                            <field name="cr_ratio" />


                        </group>

                    </group>
                    <group string='Patient History' invisible="age &lt; 50">
                        <field name="history" />

                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id='patient_action' model='ir.actions.act_window'>
        <field name="name">Patient Action</field>
        <field name="res_model">hms.patient</field>
    </record>
    <menuitem id='patient_tree_menu'
        name='Patients Data'
        parent='hms_root_menu'
        action='patient_action' />

</odoo>