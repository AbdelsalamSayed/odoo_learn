<odoo>
    <record id='view_log' model='ir.actions.act_window'>
        <field name="name">log Action</field>
        <field name="res_model">hms.patient.log</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('patient_id','=',active_id)]</field>
    </record>

    <record id='patient_tree' model='ir.ui.view'>
        <field name="name">Patient Tree</field>
        <field name="model">hms.patient</field>
        <field name='arch' type='xml'>
            <tree>
                <field name="image" widget='image' options='{"size":[50,50]}'
                    optional='1' />
                <field name="full_name" />
                <field name="age" />
                <field name="blood_type" />
                <field name="cr_ratio" />
                <field name="pcr" />
                <field name='states' />
                <field name='department_id' />
                <field name='doctors_ids' widget='many2many_tags' optional='1' />
                <field name="address" optional='1' />
                <field name="history" optional='1' />

            </tree>
        </field>
    </record>
    <record id='logs_tree' model='ir.ui.view'>
        <field name="name">logs Tree</field>
        <field name="model">hms.patient.log</field>
        <field name='arch' type='xml'>
            <tree edit='0' create='0' delete='0'>
                <field name="create_uid" />
                <field name="create_date" />
                <field name="description" />
            </tree>
        </field>
    </record>
    <record id='patient_form' model='ir.ui.view'>
        <field name="name">Patient Form</field>
        <field name="model">hms.patient</field>
        <field name='arch' type='xml'>
            <form>
                <header>

                    <button name="state_good" type="object" class="btn-primary" string='Good'
                        invisible='states == "good" or archived_state == "archived"' />
                    <button name="state_undetermined" type="object" class="btn-primary"
                        string='Undetermined'
                        invisible='states == "undetermined" or archived_state == "archived"' />
                    <button name="state_fair" type="object" class="btn-primary" string='Fair'
                        invisible='states == "fair" or archived_state == "archived"' />
                    <button name="state_serious" type="object" class="btn-primary" string='serious'
                        invisible='states == "serious" or archived_state == "archived"' />


                    <button name="%(view_log)d" type="action" class="oe_stat_button"
                        icon="fa-list" string='Logs' />

                    <field name="states" widget='statusbar' />
                </header>
                <sheet>
                    <field name="image" widget='image' class='oe_avatar'
                        readonly='archived_state == "archived"' />
                    <group string='Patient Information'>
                        <group>
                            <field name="first_name" readonly='archived_state == "archived"' />
                            <field name="birth_date" readonly='archived_state == "archived"' />
                            <field name="department_id"
                                domain='[("is_opened","=",True)]'
                                readonly='archived_state == "archived"' />
                            <field name="doctors_ids"
                                domain='[("department_id","=",department_id)]'
                                widget='many2many_tags'
                                readonly='archived_state == "archived" or not department_id' />
                            <field name="pcr" readonly='archived_state == "archived"' />
                        </group>

                        <group>
                            <field name="last_name" readonly='archived_state == "archived"' />
                            <field name="age" />
                            <field name="capacity" />
                            <field name="blood_type" readonly='archived_state == "archived"' />
                            <field name="cr_ratio" readonly='archived_state == "archived"' />
                            <field name='archived_state' />


                        </group>

                    </group>
                    <group string='Patient History' invisible="age &lt; 50">
                        <field name="history" readonly='archived_state == "archived"' />

                    </group>

                </sheet>
            </form>
        </field>
    </record>
    <record id='patient_active' model='ir.actions.act_window'>
        <field name="name">Patient active</field>
        <field name="res_model">hms.patient</field>
        <field name='domain'>[("archived_state","=","active")]</field>
    </record>
    <menuitem id='patient_tree_menu_active'
        name='Activated'
        parent='patient_menu'
        action='patient_active' />

    <record id='patient_archived' model='ir.actions.act_window'>
        <field name="name">Patient archived</field>
        <field name="res_model">hms.patient</field>
        <field name='domain'>[("archived_state","=","archived")]</field>
    </record>
    <menuitem id='patient_tree_menu_archived'
        name='Archived'
        parent='patient_menu'
        action='patient_archived' />

</odoo>