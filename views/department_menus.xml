<odoo>
    <record id='department_tree' model='ir.ui.view'>
        <field name="name">Department Tree</field>
        <field name="model">hms.department</field>
        <field name='arch' type='xml'>
            <tree>
                <field name="name" />
                <field name="capacity" />
                <field name="is_opened" />
                <field name="doctors_ids" widget='many2many_tags' />
            </tree>
        </field>
    </record>
    <record id='department_form' model='ir.ui.view'>
        <field name="name">Department Form</field>
        <field name="model">hms.department</field>
        <field name='arch' type='xml'>
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="capacity" />
                        </group>

                        <group>

                            <field name="is_opened" />
                            <field name="doctors_ids" widget='many2many_tags' />
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id='department_action' model='ir.actions.act_window'>
        <field name="name">Department Action</field>
        <field name="res_model">hms.department</field>
    </record>
    <menuitem id='department_tree_menu'
        name='Departments Data'
        parent='hms_root_menu'
        action='department_action' />

</odoo>