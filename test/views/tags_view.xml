<odoo>
    <record id="tag_view_tree" model="ir.ui.view">
        <field name="name">tag tree</field>
        <field name="model">tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="property_ids" />


            </tree>
        </field>
    </record>


    <record id="tag_view_form" model="ir.ui.view">
        <field name="name">tag form</field>
        <field name="model">tag</field>
        <field name="arch" type="xml">
            <form edit='0'>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="info">
                            <field name="property_ids" widget='many2many_tags' />
                        </group>
                        <group string="info">


                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="tag_action" model="ir.actions.act_window">
        <field name="name">tag forms</field>
        <field name="res_model">tag</field>
    </record>
    <menuitem
        id="tag_menu_item"
        name="Tag"
        parent="owner_menu"
        action="tag_action" />

</odoo>