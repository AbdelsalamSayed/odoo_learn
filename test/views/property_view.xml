<odoo>
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property tree</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <tree class='test' decoration-danger="(is_late)">
                <field name="name" />
                <field name="expected_selling_date" />
                <field name="is_late" invisible='1' />
                <field name="tags_ids" />
                <field name="description" />
                <field name="postcode" />
                <field name="date_availability" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="facades" />
                <field name="garage" />
                <field name="active" invisible='1' />
                <field name="garden" optional="1" />
                <field name="garden_area" optional="1" />
                <field name="garden_orientation" optional="1" />
            </tree>
        </field>
    </record>

    <record id="property_view_search" model="ir.ui.view">
        <field name="name">property Search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="selling_price" />
            </search>
        </field>
    </record>


    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name='button_box' class='oe_button_box'>
                        <button name='action_open_related_owner' type='object' icon='fa-user'
                            string='Owner' invisible='not owner_id' />
                    </div>
                    <widget name='web_ribbon' title='Archived' bg_color='text-bg-danger'
                        invisible='active' />
                    <widget name='web_ribbon' title='Sold' bg_color='text-bg-success'
                        invisible='state != "sold"' />
                    <header>
                        <button string='action' type='object' class='btn-primary' name='action' />
                        <button name='action_draft' type='object' class='btn-primary'
                            string='draft'
                            invisible='state in ("draft" ,"closed" )' />
                        <button name='action_pending' type='object' class='btn-primary'
                            string='pending' invisible='state in ("sold" ,"pending" ,"closed" )' />
                        <button name='action_sold' type='object' class='btn-primary'
                            string='sold'
                            invisible='state in ("draft" ,"sold" ,"closed" )' />
                        <field name="state" widget='statusbar' />
                    </header>
                    <div class="oe_title">
                        <label for="ref" />
                        <h1>
                            <field name="ref" />
                        </h1>
                        <label for="name" />
                        <h3>
                            <field name="name" />
                        </h3>
                    </div>
                    <group>
                        <group string="info">
                            <field name="description" />
                            <field name="postcode" />
                            <field name="date_availability" />
                            <field name="expected_price" />
                            <field name="selling_price" />
                            <field name="diff" />
                            <field name="owner_id" />
                            <field name="owner_phone" />
                            <field name="owner_address" />
                            <field name="active" invisible='1' />
                        </group>
                        <group>
                            <field name="bedrooms" />
                            <field name="living_area" />
                            <field name="facades" />
                            <field name="garage" />
                            <field name="garden" />
                            <field name="garden_area" />
                            <field name="garden_orientation" />
                            <field name="expected_selling_date" />
                            <field name="is_late" />
                            <field name="tags_ids" widget='many2many_tags' />
                        </group>
                    </group>
                    <notebook>
                        <page string="History">
                            <field name="history" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id='close_action' model='ir.actions.server'>
        <field name="name">Close</field>
        <field name="model_id" ref='model_property' />
        <field name="binding_model_id" ref='model_property' />
        <field name="state">code</field>
        <field name="code">
            action =records.action_closed()
        </field>
    </record>
    <record id='change_state_server_action' model='ir.actions.server'>
        <field name="name">Change State</field>
        <field name="model_id" ref='model_property' />
        <field name="binding_model_id" ref='model_property' />
        <field name="state">code</field>
        <field name="code">
            action =records.action_open_change_state_wizard()
        </field>
    </record>

    <record id="check_selling_date_cron" model='ir.cron'>
        <field name="name">property check selling</field>
        <field name="model_id" ref='model_property' />
        <field name="state">code</field>
        <field name="code">model.check_expected_selling_date()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="property_action" model="ir.actions.act_window">
        <field name="name">property forms</field>
        <field name="res_model">property</field>
    </record>
    <menuitem
        id="property_menu_item"
        name="Properties"
        parent="properties_menu"
        action="property_action"
        groups='test.property_manager_group' />


</odoo>